{
  "manifest_version": 3,
  "name": "Transcript Lens",
  "description": "Analiza transcripciones de YouTube con tu clave de OpenRouter.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://openrouter.ai/*"],
  "action": { "default_title": "Analyze video — Transcript Lens" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://openrouter.ai"
  }
}
